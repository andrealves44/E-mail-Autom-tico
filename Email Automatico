    "André Alves";

  GmailApp.sendEmail(destinatario, assunto, mensagem);
}


function configurarAutomacao() {
  // Remove acionadores antigos dessa função
  var acionadores = ScriptApp.getProjectTriggers();

  for (var i = 0; i < acionadores.length; i++) {
    if (acionadores[i].getHandlerFunction() == "enviarEmail") {
      ScriptApp.deleteTrigger(acionadores[i]);
    }
  }

  // Cria um novo acionador para toda segunda-feira
  ScriptApp.newTrigger("enviarEmail")
    .timeBased()
    .onWeekDay(ScriptApp.WeekDay.MONDAY)
    
    .atHour(8)
    .create();

  Logger.log("Automação configurada para toda segunda-feira às 08:00.");
}
